# Composer-managed dependencies — regenerate with `composer install`
/vendor/
/web/core/
/web/modules/contrib/
/web/themes/contrib/
/web/profiles/contrib/

# Node-managed dependencies — regenerate with `npm install`
node_modules/

# Drupal-generated / user-uploaded content — not code
/web/sites/default/files/

# Local Drupal settings that may contain machine-specific or secret values
/web/sites/default/settings.local.php

# Common OS/editor clutter
.DS_Store
*.log

*storybook.log
storybook-static
